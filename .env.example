# Copy this file to .env and fill in your own values. Never commit .env.

# Token of a NEW Telegram bot made with @BotFather (add it as admin to your test channel)
TELEGRAM_BOT_TOKEN=

# Optional: only react to these chat ids (comma separated). Empty = any chat the bot is in.
ALLOWED_CHAT_IDS=

# Paper-trading settings
POSITION_SIZE_SOL=0.5
TAKE_PROFIT_PCT=50
STOP_LOSS_PCT=25
MAX_HOLD_MIN=30
SLIPPAGE_PCT=1
MAX_OPEN_POSITIONS=3
PRICE_CHECK_SEC=15

# Safety filters (the trade is skipped if any check fails or cannot be done)
MIN_LIQUIDITY_USD=20000
MAX_PRICE_IMPACT_PCT=5
REQUIRE_NO_MINT_FREEZE_AUTHORITY=1

# Optional endpoints
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
